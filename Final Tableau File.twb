                  <story-point caption='The sheet shows the sum of sales happening each  month of 4 years.' captured-sheet='Area Chart of each year' id='5' />
                  <story-point caption='The map helps identify top-performing regions and underperforming states, allowing the business to focus on expanding in low-sales areas while maintaining strong performance in high-sales regions.' captured-sheet='State performance based on the sum of sales' id='3' />
                  <story-point caption='This dashboard provides a comprehensive overview of business performance across different regions, customer segments, and product categories. It is designed to help stakeholders quickly understand key trends and make data-driven decisions.' captured-sheet='Dashboard 1' id='2'>
                    <currentDeltas>
                      <worksheet name='State performance based on the sum of sales'>
                        <style delta-type='added'>
                          <style-rule element='axis'>
                            <encoding attr='space' class='0' field='[federated.1353iku0o7ddlp17esx5m116oegm].[Latitude (generated)]' field-type='quantitative' max='7085036.7777034957' min='2367331.8979868148' projection='EPSG:3857' range-type='fixed' scope='rows' type='space' />
